# Settings for `docker compose --profile app up -d --build`.
# Copy to .env (git-ignored) and edit. Plain `docker compose up -d` (Postgres
# only) works without this file.

# REQUIRED. A long random secret; the backend container refuses to start
# without it (or with the public development default, or under 32 characters).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Database password (also used by the backend's DATABASE_URL). Change it for
# anything reachable by other people.
POSTGRES_PASSWORD=neuroquest

# Port of the site on this machine
WEB_PORT=8080

# Registration limit: attempts per IP per window (every attempt counts,
# also "email already registered"; invalid requests do not)
REGISTER_MAX_PER_IP=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# 1 = load the game content on every start (safe to repeat), 0 = skip
SEED_CONTENT=1
